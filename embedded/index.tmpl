<!DOCTYPE html>
<html>
<head>
    <title>Share</title>
    <link rel="stylesheet" type="text/css" href="static/pure-min.css">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style type="text/css">
        html {
            padding: 0px;
            margin: 0px;
        }
        .date {
            position: relative;
            float: right;
        }
    </style>
</head>
<body style="margin: 30px;">
    <div class="pure-menu">
        <h1>Share</h1>
        <ul class="pure-menu-list">{{ range $idx, $name := .names }}
            <li class="pure-menu-item"><a class="pure-menu-link" href="{{ index $.name_uri $name }}">{{ $name }}<span class="date">{{ (index $.name_date $name).Format "02 Jan 06 15:04 MST" }}</span></a></li><br>{{ end }}
        </ul>
    </div>
</body>

</html>
